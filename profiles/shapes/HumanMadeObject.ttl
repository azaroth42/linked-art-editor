# SHACL shapes for HumanMadeObject records.
#
# Written for Spike S4 (Phase 0, Step 0.9: docs/spikes/S4-shacl.md) and adopted by Phase 1
# Step 1.9, which loads every profiles/shapes/*.ttl into one shapes graph. Each constraint follows
# the Linked Art model documentation (linked.art/docs/model/object/ and model/base/), cited per
# shape. The conventions, the lae:code annotation and the SPARQL prefix declarations (laes:) are
# in common.ttl and profiles/shapes/README.md.
#
# LAE-SHACL-009 and LAE-SHACL-010 (TimeSpan bounds are xsd:dateTime, and in order) were removed
# in Step 1.9: they are the Python rules LAE-RULE-005 and LAE-RULE-001 now, because rdflib cannot
# represent years before 1. The two codes are retired and must not be reused.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix aat:  <http://vocab.getty.edu/aat/> .
@prefix lae:  <urn:lae:ns:> .
@prefix laes: <urn:lae:shape:> .

# --------------------------------------------------------------------------------------------
# Names (model/base "Names"; model/object)
# --------------------------------------------------------------------------------------------

# 1. "It is strongly RECOMMENDED that every entity that should be rendered to an end user also
#    have at least one specific name" (Name in identified_by). Warning, not Violation: 66 of the
#    99 corpus objects are documentation snippets without a Name.
laes:HumanMadeObject-name
    a sh:NodeShape ;
    lae:code "LAE-SHACL-001" ;
    sh:targetClass crm:E22_Human-Made_Object ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An object should have at least one Name in identified_by."@en ;
        sh:prefixes laes: ;
        sh:select """
            SELECT $this (crm:P1_is_identified_by AS ?path)
            WHERE {
                FILTER NOT EXISTS {
                    $this crm:P1_is_identified_by ?name .
                    ?name a crm:E33_E41_Linguistic_Appellation .
                }
                FILTER EXISTS {
                    $this ?property ?value .
                    FILTER (?property NOT IN (rdf:type, rdfs:label))
                }
            }
            """ ;
    ] .

# 2. "If there is more than one name given, then there should be one that is classified_as the
#    primary name" (aat:300404670). Checked whenever the object has a Name at all.
laes:HumanMadeObject-primary-name
    a sh:NodeShape ;
    lae:code "LAE-SHACL-002" ;
    sh:targetClass crm:E22_Human-Made_Object ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "One of the object's Names should be classified as Primary Name (aat:300404670)."@en ;
        sh:prefixes laes: ;
        sh:select """
            SELECT $this (crm:P1_is_identified_by AS ?path)
            WHERE {
                FILTER EXISTS {
                    $this crm:P1_is_identified_by ?name .
                    ?name a crm:E33_E41_Linguistic_Appellation .
                }
                FILTER NOT EXISTS {
                    $this crm:P1_is_identified_by ?primary .
                    ?primary a crm:E33_E41_Linguistic_Appellation ;
                        crm:P2_has_type aat:300404670 .
                }
            }
            """ ;
    ] .

# 3. "There SHOULD be exactly one primary name given per language." Two Primary Names that share
#    a language, or that both have none, are reported. SHACL-SPARQL (cross-node comparison).
laes:HumanMadeObject-primary-name-per-language
    a sh:NodeShape ;
    lae:code "LAE-SHACL-003" ;
    sh:targetClass crm:E22_Human-Made_Object ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The object has more than one Primary Name in the same language ({?language})."@en ;
        sh:prefixes laes: ;
        sh:select """
            SELECT DISTINCT $this (crm:P1_is_identified_by AS ?path) ?language
            WHERE {
                $this crm:P1_is_identified_by ?first, ?second .
                FILTER (?first != ?second)
                ?first a crm:E33_E41_Linguistic_Appellation ; crm:P2_has_type aat:300404670 .
                ?second a crm:E33_E41_Linguistic_Appellation ; crm:P2_has_type aat:300404670 .
                OPTIONAL {
                    ?first crm:P72_has_language ?language .
                    ?second crm:P72_has_language ?language .
                }
                FILTER (
                    BOUND(?language)
                    || (NOT EXISTS { ?first crm:P72_has_language ?l1 }
                        && NOT EXISTS { ?second crm:P72_has_language ?l2 })
                )
            }
            """ ;
    ] .

# --------------------------------------------------------------------------------------------
# Production (model/object/production; model/base "Events and Activities")
# --------------------------------------------------------------------------------------------

# 4. The beginning of an object's existence is a single Production, linked with produced_by.
laes:HumanMadeObject-produced_by
    a sh:PropertyShape ;
    lae:code "LAE-SHACL-004" ;
    sh:targetClass crm:E22_Human-Made_Object ;
    sh:path crm:P108i_was_produced_by ;
    sh:maxCount 1 ;
    sh:class crm:E12_Production ;
    sh:message "produced_by must be a single Production."@en .

# 5. The actors who carried out the Production, or any part of it (the partitioning pattern for
#    multiple artists), are a Person or a Group ("Unidentified or Unknown Artist" uses a Group).
laes:HumanMadeObject-production-actor
    a sh:PropertyShape ;
    lae:code "LAE-SHACL-005" ;
    sh:targetClass crm:E22_Human-Made_Object ;
    sh:path (
        crm:P108i_was_produced_by
        [ sh:zeroOrMorePath crm:P9_consists_of ]
        crm:P14_carried_out_by
    ) ;
    sh:or ( [ sh:class crm:E21_Person ] [ sh:class crm:E74_Group ] ) ;
    sh:message "The Production (or a part of it) must be carried_out_by a Person or a Group."@en .

# --------------------------------------------------------------------------------------------
# Physical characteristics (model/object/physical)
# --------------------------------------------------------------------------------------------

# 6. Materials are recorded with made_of and "have their own Material class".
laes:HumanMadeObject-made_of
    a sh:PropertyShape ;
    lae:code "LAE-SHACL-006" ;
    sh:targetClass crm:E22_Human-Made_Object ;
    sh:path crm:P45_consists_of ;
    sh:class crm:E57_Material ;
    sh:message "made_of must refer to a Material."@en .

# 7. A dimension has its numeric value in `value` (exactly one).
laes:Dimension-value
    a sh:PropertyShape ;
    lae:code "LAE-SHACL-007" ;
    sh:targetObjectsOf crm:P43_has_dimension ;
    sh:path crm:P90_has_value ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:message "A Dimension must have exactly one numeric value."@en .

# 8. "The unit used ... should also be given from a controlled vocabulary": one MeasurementUnit.
laes:Dimension-unit
    a sh:PropertyShape ;
    lae:code "LAE-SHACL-008" ;
    sh:targetObjectsOf crm:P43_has_dimension ;
    sh:severity sh:Warning ;
    sh:path crm:P91_has_unit ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class crm:E58_Measurement_Unit ;
    sh:message "A Dimension should have one unit that is a MeasurementUnit."@en .

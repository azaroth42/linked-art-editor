# SHACL shapes for Place records (linked.art/docs/model/place/). Conventions, lae:code and the
# SPARQL prefix declarations (laes:) are in common.ttl and profiles/shapes/README.md.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix lae:  <urn:lae:ns:> .
@prefix laes: <urn:lae:shape:> .

# 18. "It is strongly RECOMMENDED that every entity ... have at least one specific name". A
#     place that has nothing but a type and a label (a new draft) is not reported.
laes:Place-name
    a sh:NodeShape ;
    lae:code "LAE-SHACL-018" ;
    sh:targetClass crm:E53_Place ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A place should have at least one Name in identified_by."@en ;
        sh:prefixes laes: ;
        sh:select """
            SELECT $this (crm:P1_is_identified_by AS ?path)
            WHERE {
                FILTER NOT EXISTS {
                    $this crm:P1_is_identified_by ?name .
                    ?name a crm:E33_E41_Linguistic_Appellation .
                }
                FILTER EXISTS {
                    $this ?property ?value .
                    FILTER (?property NOT IN (rdf:type, rdfs:label))
                }
            }
            """ ;
    ] .

# 19. "Places can be part of other places": the larger place is a Place.
laes:Place-part_of
    a sh:PropertyShape ;
    lae:code "LAE-SHACL-019" ;
    sh:targetClass crm:E53_Place ;
    sh:path crm:P89_falls_within ;
    sh:class crm:E53_Place ;
    sh:message "part_of of a place must refer to a Place."@en .

{
  "name": "lae-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && vite build -c vite.reader.config.ts",
    "build:reader": "vite build -c vite.reader.config.ts",
    "preview": "vite preview",
    "lint": "eslint . && bash ../scripts/check-logical-css.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:spike-s5": "playwright test -c src/spikes/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "uv run --project ../backend --locked python ../scripts/export_openapi.py | openapi-typescript -o src/api/schema.d.ts",
    "api:check": "uv run --project ../backend --locked python ../scripts/export_openapi.py | openapi-typescript | diff -u src/api/schema.d.ts - || { echo \"src/api/schema.d.ts is stale: run corepack pnpm api:generate\" >&2; exit 1; }"
  },
  "dependencies": {
    "@digirati/canvas-panel-web-components": "1.0.74",
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-query": "^5.108.2",
    "ajv": "^8.20.0",
    "edtf": "4.12.0",
    "i18next": "^27.2.3",
    "i18next-icu": "^2.7.1",
    "intl-messageformat": "^12.2.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "uuid": "^14.0.3",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}

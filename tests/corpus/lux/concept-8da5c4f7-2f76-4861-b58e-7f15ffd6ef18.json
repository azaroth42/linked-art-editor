nguage","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}]},{"type":"Name","content":"ch'ing t'ung","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}]},{"type":"Name","content":"铜锡合金","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}]},{"type":"Name","content":"青銅色","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","notation":"zh","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}],"classified_as":[]},{"type":"Name","content":"qīng tóng sè","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}]},{"type":"Name","content":"qing tong se","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}]},{"type":"Name","content":"ch'ing t'ung se","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}]},{"type":"Name","content":"古銅色","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}]},{"type":"Name","content":"برونز","language":[{"id":"https://lux.collections.yale.edu/data/concept/571751a1-f12b-4418-8774-bbf30b7b663c","type":"Language","_label":"Arabic","notation":"ar","equivalent":[{"id":"http://vocab.getty.edu/aat/300387843","type":"Language","_label":"Arabic"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/f7ef5bb4-e7fb-443d-9c6b-371a23e717ec","type":"Type","_label":"Primary Name","equivalent":[{"id":"http://vocab.getty.edu/aat/300404670","type":"Type","_label":"Final: Primary Name"}]}]},{"type":"Name","content":"bronzo","language":[{"id":"https://lux.collections.yale.edu/data/concept/6a226087-9e10-4b25-a73f-e106b69f0d87","type":"Language","_label":"Italian","notation":"it","equivalent":[{"id":"http://vocab.getty.edu/aat/300388474","type":"Language","_label":"Italian"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/f7ef5bb4-e7fb-443d-9c6b-371a23e717ec","type":"Type","_label":"Primary Name","equivalent":[{"id":"http://vocab.getty.edu/aat/300404670","type":"Type","_label":"Final: Primary Name"}]}]},{"type":"Name","content":"कांसा","language":[{"id":"https://lux.collections.yale.edu/data/concept/a995fc45-9c9b-424d-80ae-d9e645b822e7","type":"Language","_label":"Hindi","notation":"hi","equivalent":[{"id":"http://vocab.getty.edu/aat/300388412","type":"Language","_label":"Hindi"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/f7ef5bb4-e7fb-443d-9c6b-371a23e717ec","type":"Type","_label":"Primary Name","equivalent":[{"id":"http://vocab.getty.edu/aat/300404670","type":"Type","_label":"Final: Primary Name"}]}]},{"type":"Name","content":"برونزي","language":[{"id":"https://lux.collections.yale.edu/data/concept/571751a1-f12b-4418-8774-bbf30b7b663c","type":"Language","_label":"Arabic","notation":"ar","equivalent":[{"id":"http://vocab.getty.edu/aat/300387843","type":"Language","_label":"Arabic"}]}],"classified_as":[]},{"type":"Identifier","content":"Cu·Sn"}],"referred_to_by":[{"type":"LinguisticObject","content":"Refers to a broad range of alloys of copper, specifically any non-ferrous alloy of copper, tin, and zinc or other trace metals. Bronze was made before 3,000 BCE - possibly as early as 10,000 BCE, although its common use in tools and decorative items is dated only in later artifacts. The proportions of copper and tin vary widely, from 70 to 95 percent copper in surviving ancient artifacts. Because of the copper base, bronze may be very malleable and easy to work. By the Middle Ages in Europe, it was recognized that using the metals in certain proportions could yield specific properties. Some modern bronzes contain no tin at all, substituting other metals such as aluminum, manganese, and even zinc. Historically, the term was used interchangeably with \"latten.\" U.S. standard bronze is composed of 90% copper, 7% tin and 3% zinc. Ancient bronze alloys sometimes contained up to 14% tin.","language":[{"id":"https://lux.collections.yale.edu/data/concept/dfa53b96-4eda-4c9a-b091-10008a726c38","type":"Language","_label":"English","equivalent":[{"id":"http://vocab.getty.edu/aat/300388277","type":"Language","_label":"English"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b079998d-bb47-470a-ad7d-d938bd091f8a","type":"Type","_label":"Brief Text","equivalent":[{"id":"http://vocab.getty.edu/aat/300418049","type":"Type","_label":"Brief Text"}]}]}]},{"type":"LinguisticObject","content":"Aleación de cobre con un elemento principal de la aleación que sea un metal, excepto níquel o zinc.","language":[{"id":"https://lux.collections.yale.edu/data/concept/4839f816-732d-4d43-935d-297c4696ec09","type":"Language","_label":"Spanish","equivalent":[{"id":"http://vocab.getty.edu/aat/300389311","type":"Language","_label":"Spanish"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"Koperlegering die als belangrijkste legeringselement niet nikkel of zink heeft.","language":[{"id":"https://lux.collections.yale.edu/data/concept/5e2c762c-bd95-4fe8-affc-5d61e5ce2159","type":"Language","_label":"Dutch","equivalent":[{"id":"http://vocab.getty.edu/aat/300388256","type":"Language","_label":"Dutch"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"意指各種銅的合金，尤指任何非含鐵的銅、錫以及鋅和其他微量金屬的合金。青銅的製成可追溯到西元前三千年之前，最早可能出現於西元前一萬年前，雖然青銅普遍用於各式工具和裝飾性物品，但只有透過後期的手工藝品才能確認其年代。銅和錫的使用比例差異甚大，現存的古老手工藝品中，銅的含量從百分之七十到九十五不等。因為以銅為基底，青銅可能會非常具有延展性且和容易精工細做。到了中古世紀的歐洲，一般公認使用一定比例的各類金屬，可以產生出特定的屬性。部分現代青銅的成分完全不含錫，而是以鋁、鎂，甚或是鋅等的其他金屬來取代。就歷史意義而言，此一詞彙是可以和「黃銅薄片」（latten）交互使用的。美國標準的青銅是由百分之九十的銅、百分之七的錫，以及百分之三的鋅所組合而成。古代的青銅合金有時候含有高達百分之十四的錫。","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"يشير إلى مجموعة واسعة من سبائك النحاس، وتحديدًا أي سبيكة غير حديدية من النحاس والقصدير والزنك أو المعادن النزرة الأخرى. تم صنع البرونز قبل 3000 قبل الميلاد - ربما في وقت مبكر من 10000 قبل الميلاد، على الرغم من أن استخدامه الشائع في الأدوات والعناصر الزخرفية يرجع تاريخه فقط إلى المصنوعات اليدوية اللاحقة. تختلف نسب النحاس والقصدير بشكل كبير، حيث تتراوح نسبة النحاس من 70 إلى 95 بالمائة في القطع الأثرية القديمة الباقية. بسبب القاعدة النحاسية، قد يكون البرونز مرنًا جدًا وسهل العمل. وبحلول العصور الوسطى في أوروبا، كان من المسلم به أن استخدام المعادن بنسب معينة يمكن أن يؤدي إلى خصائص محددة. بعض أنواع البرونز الحديثة لا تحتوي على قصدير على الإطلاق، لتحل محل معادن أخرى مثل الألومنيوم والمنغنيز وحتى الزنك. تاريخيًا، تم استخدام هذا المصطلح بالتبادل مع كلمة \"latten\". يتكون البرونز القياسي الأمريكي من 90% نحاس، و7% قصدير، و3% زنك. تحتوي سبائك البرونز القديمة أحيانًا على ما يصل إلى 14% من القصدير.","language":[{"id":"https://lux.collections.yale.edu/data/concept/571751a1-f12b-4418-8774-bbf30b7b663c","type":"Language","_label":"Arabic","equivalent":[{"id":"http://vocab.getty.edu/aat/300387843","type":"Language","_label":"Arabic"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"Refere-se a uma ampla gama de ligas de cobre, especificamente qualquer liga não ferrosa de cobre, estanho e zinco ou outros metais vestigiais. O bronze foi fabricado antes de 3.000 aC - possivelmente já em 10.000 aC, embora seu uso comum em ferramentas e itens decorativos seja datado apenas em artefatos posteriores. As proporções de cobre e estanho variam amplamente, de 70 a 95% de cobre nos artefatos antigos sobreviventes. Por causa da base de cobre, o bronze pode ser muito maleável e fácil de trabalhar. Na Idade Média na Europa, reconheceu-se que o uso de metais em certas proporções poderia produzir propriedades específicas. Alguns bronzes modernos não contêm estanho, substituindo outros metais como alumínio, manganês e até zinco. Historicamente, o termo era usado de forma intercambiável com \"latten\". O bronze padrão dos EUA é composto por 90% de cobre, 7% de estanho e 3% de zinco. As ligas de bronze antigas às vezes continham até 14% de estanho.","language":[{"id":"https://lux.collections.yale.edu/data/concept/5abd8c6e-52ca-462f-8d7e-21f73068410c","type":"Language","_label":"Portuguese","equivalent":[{"id":"http://vocab.getty.edu/aat/300389115","type":"Language","_label":"Portuguese"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"Suivant l’utilisateur, désigne aussi bien un alliage à base de cuivredans lequel l’étain est l’élément d’addition principal que toutalliage à base de cuivre. Pour lever l’ambiguité, il estrecommandé de restreindre le terme aux alliages cuivre-étain.","language":[{"id":"https://lux.collections.yale.edu/data/concept/ae981401-8fb9-46ba-ad96-f0552135efb9","type":"Language","_label":"French","equivalent":[{"id":"http://vocab.getty.edu/aat/300388306","type":"Language","_label":"French"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"A range of brownish colors resembling the color of bronze metal, an alloy of copper and tin.","language":[{"id":"https://lux.collections.yale.edu/data/concept/dfa53b96-4eda-4c9a-b091-10008a726c38","type":"Language","_label":"English","equivalent":[{"id":"http://vocab.getty.edu/aat/300388277","type":"Language","_label":"English"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b079998d-bb47-470a-ad7d-d938bd091f8a","type":"Type","_label":"Brief Text","equivalent":[{"id":"http://vocab.getty.edu/aat/300418049","type":"Type","_label":"Brief Text"}]}]}]},{"type":"LinguisticObject","content":"指一特定範圍的褐色色彩，近似於銅錫合金的金屬青銅之顏色。","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"Een reeks bruinachtige kleuren die lijken op de kleur van het metaal brons, een legering van koper en tin.","language":[{"id":"https://lux.collections.yale.edu/data/concept/5e2c762c-bd95-4fe8-affc-5d61e5ce2159","type":"Language","_label":"Dutch","equivalent":[{"id":"http://vocab.getty.edu/aat/300388256","type":"Language","_label":"Dutch"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"Uma gama de cores amarronzadas que lembram a cor do bronze, uma liga de cobre e estanho.","language":[{"id":"https://lux.collections.yale.edu/data/concept/5abd8c6e-52ca-462f-8d7e-21f73068410c","type":"Language","_label":"Portuguese","equivalent":[{"id":"http://vocab.getty.edu/aat/300389115","type":"Language","_label":"Portuguese"}]}],"classified_as":[{"id":"https:
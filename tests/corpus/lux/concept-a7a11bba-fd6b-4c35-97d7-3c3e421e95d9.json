,"type":"Language","_label":"Japanese"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/f7ef5bb4-e7fb-443d-9c6b-371a23e717ec","type":"Type","_label":"Primary Name","equivalent":[{"id":"http://vocab.getty.edu/aat/300404670","type":"Type","_label":"Final: Primary Name"}]}]},{"type":"Name","content":"رسام","language":[{"id":"https://lux.collections.yale.edu/data/concept/571751a1-f12b-4418-8774-bbf30b7b663c","type":"Language","_label":"Arabic","notation":"ar","equivalent":[{"id":"http://vocab.getty.edu/aat/300387843","type":"Language","_label":"Arabic"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/f7ef5bb4-e7fb-443d-9c6b-371a23e717ec","type":"Type","_label":"Primary Name","equivalent":[{"id":"http://vocab.getty.edu/aat/300404670","type":"Type","_label":"Final: Primary Name"}]}]},{"type":"Name","content":"चित्रकार","language":[{"id":"https://lux.collections.yale.edu/data/concept/a995fc45-9c9b-424d-80ae-d9e645b822e7","type":"Language","_label":"Hindi","notation":"hi","equivalent":[{"id":"http://vocab.getty.edu/aat/300388412","type":"Language","_label":"Hindi"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/f7ef5bb4-e7fb-443d-9c6b-371a23e717ec","type":"Type","_label":"Primary Name","equivalent":[{"id":"http://vocab.getty.edu/aat/300404670","type":"Type","_label":"Final: Primary Name"}]}]},{"type":"Name","content":"pittrice","language":[{"id":"https://lux.collections.yale.edu/data/concept/6a226087-9e10-4b25-a73f-e106b69f0d87","type":"Language","_label":"Italian","equivalent":[{"id":"http://vocab.getty.edu/aat/300388474","type":"Language","_label":"Italian"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/c99c4343-b769-4a81-9f28-6aec5d281251","type":"Type","_label":"Alternate Name","equivalent":[{"id":"http://vocab.getty.edu/aat/300264273","type":"Type","_label":"Alternate Name"}]}]},{"type":"Name","content":"painters (artists)","classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/f7ef5bb4-e7fb-443d-9c6b-371a23e717ec","type":"Type","_label":"Primary Name","equivalent":[{"id":"http://vocab.getty.edu/aat/300404670","type":"Type","_label":"Primary Name"}]}]}],"referred_to_by":[{"type":"LinguisticObject","content":"People who practice the art of painting, which is applying pigments suspended in liquid to a surface to create an expressive or communicative image. For people who apply paint primarily to protect or give simple color to a surface, use \"painters (tradespeople).\"","language":[{"id":"https://lux.collections.yale.edu/data/concept/dfa53b96-4eda-4c9a-b091-10008a726c38","type":"Language","_label":"English","equivalent":[{"id":"http://vocab.getty.edu/aat/300388277","type":"Language","_label":"English"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b079998d-bb47-470a-ad7d-d938bd091f8a","type":"Type","_label":"Brief Text","equivalent":[{"id":"http://vocab.getty.edu/aat/300418049","type":"Type","_label":"Brief Text"}]}]}]},{"type":"LinguisticObject","content":"Se refiere a gente que practica el arte de la pintura, que es aplicación de pigmentos suspendidos en una solución líquida a una superficie para crear una imagen expresiva o comunicativa. Para gente que aplica pintura principalmente para proteger o simplemente dar color a una superficie, use \"pintor (comerciante)\".","language":[{"id":"https://lux.collections.yale.edu/data/concept/4839f816-732d-4d43-935d-297c4696ec09","type":"Language","_label":"Spanish","equivalent":[{"id":"http://vocab.getty.edu/aat/300389311","type":"Language","_label":"Spanish"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"Verwijst naar personen die de schilderkunst beoefenen, hetgeen wil zeggen dat zij in vloeistof gesuspendeerd pigment aanbrengen op een oppervlak om daarmee een expressief of communicatief beeld te scheppen. Gebruik ‘huisschilders’ voor personen die verf aanbrengen om oppervlakken te beschermen of een kleur te geven.","language":[{"id":"https://lux.collections.yale.edu/data/concept/5e2c762c-bd95-4fe8-affc-5d61e5ce2159","type":"Language","_label":"Dutch","equivalent":[{"id":"http://vocab.getty.edu/aat/300388256","type":"Language","_label":"Dutch"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"以繪畫技術為業的人員，其運用懸浮在液體上的顏料在平面上創作出生動而具意象的圖像。若在平面塗抹顏料或簡單著色，以提供保護的人員，稱之為「油漆匠(工匠)」。","language":[{"id":"https://lux.collections.yale.edu/data/concept/6af4c153-46f3-4ee3-8c3a-36bc210f5a2e","type":"Language","_label":"Chinese","equivalent":[{"id":"http://vocab.getty.edu/aat/300388113","type":"Language","_label":"Chinese"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"Voir aussi les vedettes du type Peintres [adjectif de nationalité ou géographique]","language":[{"id":"https://lux.collections.yale.edu/data/concept/ae981401-8fb9-46ba-ad96-f0552135efb9","type":"Language","_label":"French","equivalent":[{"id":"http://vocab.getty.edu/aat/300388306","type":"Language","_label":"French"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b079998d-bb47-470a-ad7d-d938bd091f8a","type":"Type","_label":"Brief Text","equivalent":[{"id":"http://vocab.getty.edu/aat/300418049","type":"Type","_label":"Brief Text"}]}]}]},{"type":"LinguisticObject","content":"artist who practices painting","language":[{"id":"https://lux.collections.yale.edu/data/concept/dfa53b96-4eda-4c9a-b091-10008a726c38","type":"Language","_label":"English","equivalent":[{"id":"http://vocab.getty.edu/aat/300388277","type":"Language","_label":"English"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b079998d-bb47-470a-ad7d-d938bd091f8a","type":"Type","_label":"Brief Text","equivalent":[{"id":"http://vocab.getty.edu/aat/300418049","type":"Type","_label":"Brief Text"}]}]}]},{"type":"LinguisticObject","content":"tipo de artista plástico","language":[{"id":"https://lux.collections.yale.edu/data/concept/4839f816-732d-4d43-935d-297c4696ec09","type":"Language","_label":"Spanish","equivalent":[{"id":"http://vocab.getty.edu/aat/300389311","type":"Language","_label":"Spanish"}]}],"classified_as":[{"id":"https://lux.collections.yale.edu/data/concept/b9d84f17-662e-46ef-ab8b-7499717f8337","type":"Type","_label":"Description","equivalent":[{"id":"http://vocab.getty.edu/aat/300435416","type":"Type","_label":"Description"}]}]},{"type":"LinguisticObject","content":"personne pratiquant la peinture","language":[{"id":"https://lux.collections.yale.edu/data/concept/ae981401-8fb9-46ba-ad96-f0552135efb9","type":"Language","_label":"French","equivalent":[{"id":"http://vocab.getty.edu/aat/30038
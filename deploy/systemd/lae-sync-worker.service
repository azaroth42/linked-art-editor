# Template unit for the `sync-worker` process (`lae sync-worker`): applies the outbox to QLever.
# Needs LAE_QLEVER_URL (LAE_QLEVER_UPDATE_URL if updates go elsewhere) and
# LAE_QLEVER_ACCESS_TOKEN. One worker per database: a second one waits for the advisory lock.
# LAE_SYNC_METRICS_PORT enables GET /metrics on LAE_SYNC_METRICS_HOST (default 127.0.0.1).
# Assumes the layout in deploy/README.md ("Production with systemd"); adjust the paths and user
# before installing.
#
# Exit codes and restarts (docs/contracts/1.11-sync-worker.md §8.5, ADR-0039):
#   1  may pass by itself (Postgres unreachable, the connection lost, an error of unknown kind):
#      restarted every 5 s, without limit (StartLimitIntervalSec=0), so an outage of any length
#      recovers by itself.
#   2  refuses to start (a setting missing, the watermark not an integer): not restarted.
#   4  a database error that cannot pass by itself (SQLSTATE class 42, 23, 22, 0A): not
#      restarted. Fix the cause (journalctl -u lae-sync-worker, line sync_worker_failed), then
#      `sudo systemctl start lae-sync-worker`. See "When the sync worker stops" in
#      deploy/README.md.
# Never add 1 to RestartPreventExitStatus= and never add a StartLimitBurst=: either would leave
# the worker down after a Postgres outage.

[Unit]
Description=Laertes: sync-worker (outbox to QLever)
Documentation=https://github.com/azaroth42/linked-art-editor/blob/main/deploy/README.md
Wants=network-online.target
After=network-online.target postgresql.service qlever.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=lae
Group=lae
WorkingDirectory=/opt/lae
EnvironmentFile=/etc/lae/lae.env
ExecStart=/opt/lae/backend/.venv/bin/lae sync-worker
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2 4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

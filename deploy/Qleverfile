# Qleverfile for the Linked Art Editor, use with https://github.com/qlever-dev/qlever-control
#
# Structure follows lux/qlever-middletier/files/Qleverfile; memory and threads are sized for a
# developer laptop. QLever runs natively (SYSTEM = native): `make up` / `make down` in
# development, deploy/systemd/qlever.service in production (see deploy/README.md).
#
# qlever-control works in the current directory, which holds the index files, so the index
# directory is wherever it runs (QLEVER_DIR in the Makefile, WorkingDirectory in systemd):
#   cd <index dir> && qlever --qleverfile <repo>/deploy/Qleverfile <command>
# Values written as $$(...) are evaluated by the shell when the file is read (`$$` escapes `$`),
# so these environment variables override the defaults:
#   QLEVER_PORT              server port                      (default 7010)
#   QLEVER_INPUT_FILES       N-Quads/N-Triples input, plain or .gz (default *.nt)
#   LAE_QLEVER_ACCESS_TOKEN  token required for SPARQL Update (default: none, so read-only)
# Any value can also be overridden per call on the command line, e.g. `qlever start --port 7003`.
#
# qlever-server listens on all interfaces (0.0.0.0 is hard-coded in QLever's Server.cpp; there
# is no bind option). Keep the port closed to the outside with a host firewall; the only public
# SPARQL entry point is the api's read-only /sparql proxy (Phase 2).
#
# QLever is a derived index of Postgres (decision A1): nothing is downloaded. `qlever get-data`
# only creates an empty input so that a fresh installation starts with an empty index. Real data
# comes from `lae bootstrap export-nt` / `lae bootstrap build-index` (Phase 1 Step 1.12) and
# from the sync worker's SPARQL updates, which survive restarts because of PERSIST_UPDATES.
#
# qlever get-data  # creates an empty lae-empty.nt
# qlever index     # builds the index (text index from literals, ql:has-word triples)
# qlever start     # starts the server on localhost:$QLEVER_PORT
# qlever stop      # stops it; pass --cmdline-regex to match only this port (see the Makefile)

[data]
NAME              = lae
GET_DATA_CMD      = touch lae-empty.nt
DESCRIPTION       = Linked Art Editor: published records
TEXT_DESCRIPTION  = Literals of published Linked Art records
# N-Quads, of which N-Triples is a subset: records are in the default graph, sidecar labels in
# urn:graph:sidecar:<source> graphs (`lae bootstrap export-nt`).
FORMAT            = nq

[index]
INPUT_FILES       = $$(printf '%s' "$${QLEVER_INPUT_FILES:-*.nt}")
CAT_INPUT_FILES   = gzip -dcf ${INPUT_FILES}
SETTINGS_JSON     = { "ascii-prefixes-only": true, "num-triples-per-batch": 500000 }
VOCABULARY_TYPE   = on-disk-compressed
STXXL_MEMORY      = 4G
PARALLEL_PARSING  = true
TEXT_INDEX        = from_literals
ADD_HAS_WORD_TRIPLES = true

[server]
HOST_NAME          = localhost
PORT               = $$(printf '%s' "$${QLEVER_PORT:-7010}")
ACCESS_TOKEN       = $$(printf '%s' "$${LAE_QLEVER_ACCESS_TOKEN:-}")
MEMORY_FOR_QUERIES = 4G
CACHE_MAX_SIZE     = 2G
CACHE_MAX_SIZE_SINGLE_ENTRY = 1G
NUM_THREADS        = 4
TIMEOUT            = 60s
PERSIST_UPDATES    = true
# Prometheus /metrics on the server port (access token required): `qlever_delta_triples` is the
# rebuild trigger (Phase 2 Steps 2.17-2.18, Spike S1 in docs/spikes/S1-qlever.md).
ENABLE_METRICS     = true

[runtime]
SYSTEM = native

[ui]
UI_CONFIG = default

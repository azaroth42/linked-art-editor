root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,mjs,json}]
max_line_length = 100

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Corpus and vendored files are kept byte-for-byte as copied (Step 0.4): never reformat them.
[{tests/corpus/**.json,profiles/schema/*.json,profiles/context/*.json}]
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false
max_line_length = off
